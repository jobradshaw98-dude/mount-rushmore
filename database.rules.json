{
  "rules": {
    ".read": false,
    ".write": false,
    "solo": {
      "$day": {
        ".read": "$day.matches(/^[0-9]{1,5}$/)",
        "$uid": {
          ".write": "auth != null && auth.uid === $uid && !data.exists()",
          ".validate": "newData.hasChildren(['name', 'score', 'picks', 'ts'])",
          "name": {
            ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 18"
          },
          "score": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 521"
          },
          "ts": {
            ".validate": "newData.val() === now"
          },
          "picks": {
            "$i": {
              ".validate": "$i.matches(/^[0-3]$/) && newData.isString() && newData.val().length > 0 && newData.val().length <= 60"
            }
          },
          "$other": {
            ".validate": false
          }
        },
        ".indexOn": [
          "score"
        ]
      }
    },
    "rounds": {
      "$k": {
        ".read": "$k.matches(/^[A-Z0-9]{6}-[0-9]{1,5}-[0-9]{1,2}$/)",
        "events": {
          "$e": {
            ".write": "auth != null && !data.exists() && $k.matches(/^[A-Z0-9]{6}-[0-9]{1,5}-[0-9]{1,2}$/) && $e.matches(/^-[A-Za-z0-9_-]{19}$/)",
            ".validate": "newData.hasChildren(['type', 'pid', 'uid']) && newData.child('uid').val() === auth.uid",
            "type": {
              ".validate": "newData.isString() && newData.val().length <= 12"
            },
            "pid": {
              ".validate": "newData.isString() && newData.val().length <= 24"
            },
            "uid": {
              ".validate": "newData.isString()"
            },
            "at": {
              ".validate": "newData.isNumber()"
            },
            "name": {
              ".validate": "newData.isString() && newData.val().length <= 18"
            },
            "text": {
              ".validate": "newData.isString() && newData.val().length <= 60"
            },
            "n": {
              ".validate": "newData.isNumber()"
            },
            "day": {
              ".validate": "newData.isNumber()"
            },
            "round": {
              ".validate": "newData.isNumber()"
            },
            "topic": {
              ".validate": "newData.isString() && newData.val().length <= 20"
            },
            "order": {
              "$i": {
                ".validate": "$i.matches(/^[0-9]$/) && ((newData.isString() && newData.val().length <= 24) || newData.isNumber())"
              }
            },
            "$other": {
              ".validate": false
            },
            "sv": {
              ".validate": "newData.val() === now"
            },
            "k": {
              ".validate": "newData.isString() && newData.val().length <= 70"
            }
          }
        }
      }
    },
    "crewRounds": {
      "$g": {
        "$day": {
          ".read": "$g.matches(/^[A-Z0-9]{6}$/) && $day.matches(/^[0-9]{1,5}$/)",
          "$n": {
            ".write": "auth != null && !data.exists() && $g.matches(/^[A-Z0-9]{6}$/) && $day.matches(/^[0-9]{1,5}$/)",
            ".validate": "newData.val() === true && $n.matches(/^[1-9][0-9]?$/)"
          }
        },
        ".read": "$g.matches(/^[A-Z0-9]{6}$/)"
      }
    },
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid && auth.token.firebase.sign_in_provider !== 'anonymous'",
        "name": {
          ".validate": "newData.isString() && newData.val().length <= 18"
        },
        "crews": {
          "$g": {
            ".validate": "$g.matches(/^[A-Z0-9]{6}$/) && newData.hasChildren(['pid'])",
            "pid": {
              ".validate": "newData.isString() && newData.val().length <= 24"
            },
            "at": {
              ".validate": "newData.isNumber()"
            },
            "$o": {
              ".validate": false
            }
          }
        },
        "solo": {
          "$day": {
            ".validate": "$day.matches(/^[0-9]{1,5}$/) && newData.isString() && newData.val().length <= 3000"
          }
        },
        "$other": {
          ".validate": false
        },
        "days": {
          ".validate": "newData.isString() && newData.val().length <= 4000"
        },
        "left": {
          "$g": {
            ".validate": "$g.matches(/^[A-Z0-9]{6}$/) && newData.isBoolean()"
          }
        }
      }
    },
    "crews": {
      "$g": {
        ".read": "$g.matches(/^[A-Z0-9]{6}$/)",
        "name": {
          ".write": "auth != null && $g.matches(/^[A-Z0-9]{6}$/) && root.child('crewRounds').child($g).exists()",
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 24"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "soloCount": {
      "$day": {
        ".read": "$day.matches(/^[0-9]{1,5}$/)",
        ".write": false
      }
    },
    "notify": {
      "$round": {
        "$id": {
          ".write": "auth != null && !data.exists() && $round.matches(/^[A-Z0-9]{6}-[0-9]{1,5}-[0-9]{1,2}$/) && root.child('rounds').child($round).exists()",
          ".validate": "newData.hasChildren([\"kind\",\"to\"])",
          "kind": {
            ".validate": "newData.isString() && (newData.val() === \"turn\" || newData.val() === \"order\" || newData.val() === \"bonus\")"
          },
          "to": {
            ".validate": "newData.isString() && newData.val().matches(/^[a-z0-9]{3,24}$/)"
          },
          "$other": {
            ".validate": false
          },
          "n": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 99"
          }
        }
      }
    },
    "pushSubs": {
      "$g": {
        "$pid": {
          "$sid": {
            ".write": "auth != null && $sid === auth.uid && root.child('pidOwner').child($g).child($pid).val() === auth.uid",
            "$dev": {
              ".validate": "$dev.matches(/^[a-z0-9]{1,14}$/) && newData.hasChildren(['endpoint','keys'])",
              "endpoint": {
                ".validate": "newData.isString() && newData.val().beginsWith('https://') && newData.val().length <= 1000"
              },
              "expirationTime": {
                ".validate": "newData.isNumber()"
              },
              "keys": {
                "p256dh": {
                  ".validate": "newData.isString() && newData.val().length <= 200"
                },
                "auth": {
                  ".validate": "newData.isString() && newData.val().length <= 100"
                },
                "$o": {
                  ".validate": false
                }
              },
              "$o": {
                ".validate": false
              }
            }
          }
        }
      }
    },
    "pidOwner": {
      "$g": {
        "$pid": {
          ".write": "auth != null && $g.matches(/^[A-Z0-9]{6}$/) && $pid.matches(/^[a-z0-9]{3,24}$/) && root.child('crewRounds').child($g).exists() && (!data.exists() || data.val() === auth.uid || root.child('users').child(auth.uid).child('crews').child($g).child('pid').val() === $pid)",
          ".validate": "newData.val() === auth.uid"
        }
      }
    },
    "suggestions": {
      "$id": {
        ".write": "auth != null && !data.exists() && $id.matches(/^-[A-Za-z0-9_-]{19}$/)",
        ".validate": "newData.hasChildren(['text','uid','ts'])",
        "text": {
          ".validate": "newData.isString() && newData.val().length >= 3 && newData.val().length <= 80"
        },
        "name": {
          ".validate": "newData.isString() && newData.val().length <= 18"
        },
        "uid": {
          ".validate": "newData.val() === auth.uid"
        },
        "ts": {
          ".validate": "newData.val() === now"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "catalog": {
      ".read": true,
      "topics": {
        "$id": {
          ".write": "auth != null && auth.uid === 'catalog-publisher' && !data.exists()",
          ".validate": "$id.matches(/^[a-z0-9]{2,14}$/) && newData.hasChildren(['name','cat','from','seq']) && newData.child('from').isNumber() && newData.child('from').val() - 2 > (now - 1790492400000) / 86400000 && newData.parent().parent().child('lists').child($id).child('base').val() === $id && newData.parent().parent().child('lists').child($id).child('from').val() === newData.child('from').val()",
          "name": {
            ".validate": "newData.isString() && newData.val().length >= 2 && newData.val().length <= 40"
          },
          "note": {
            ".validate": "newData.isString() && newData.val().length <= 60"
          },
          "cat": {
            ".validate": "newData.isString() && newData.val().matches(/^(food|sports|screen|music|play|life|places|brands|people)$/)"
          },
          "from": {
            ".validate": "newData.isNumber()"
          },
          "seq": {
            ".validate": "newData.isNumber()"
          },
          "$other": {
            ".validate": false
          }
        }
      },
      "lists": {
        "$vid": {
          ".write": "auth != null && auth.uid === 'catalog-publisher' && !data.exists()",
          ".validate": "$vid.matches(/^[a-z0-9_]{2,20}$/) && newData.hasChildren(['base','from','items']) && newData.child('from').isNumber() && newData.child('from').val() - 2 > (now - 1790492400000) / 86400000 && newData.parent().parent().child('topics').child(newData.child('base').val()).exists() && newData.child('from').val() >= newData.parent().parent().child('topics').child(newData.child('base').val()).child('from').val()",
          "base": {
            ".validate": "newData.isString()"
          },
          "from": {
            ".validate": "newData.isNumber()"
          },
          "items": {
            ".validate": "newData.isString() && newData.val().length <= 4000"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },
    "suggestionIdeas": {
      ".read": true,
      "$id": {
        ".write": false
      }
    }
  }
}
